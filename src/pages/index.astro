---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Treatments from '../components/Treatments.astro';
import GuidedStart from '../components/GuidedStart.astro';
import Team from '../components/Team.astro';
import Reviews from '../components/Reviews.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
---
<Base>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" href="/img/hero/hero-arka-1536.avif" imagesrcset="/img/hero/hero-arka-768.avif 768w, /img/hero/hero-arka-1536.avif 1536w" imagesizes="100vw" fetchpriority="high" />
    <link rel="preload" as="image" type="image/avif" href="/img/hero/hero-on-1152.avif" imagesrcset="/img/hero/hero-on-768.avif 768w, /img/hero/hero-on-1152.avif 1152w, /img/hero/hero-on-1536.avif 1536w" imagesizes="(max-width: 760px) 100vw, 1140px" fetchpriority="high" />
  </Fragment>
  <Header />
  <main id="main">
    <Hero />
    <Treatments />
    <GuidedStart />
    <Team />
    <Reviews />
  </main>
  <Footer />
  <MobileBar />
  <script>
    import '../scripts/main';
  </script>
</Base>
