---
import Page from '../../layouts/Page.astro';
import PageHead from '../../components/PageHead.astro';
import { FEE_GROUPS, PRICES_UPDATED, eur } from '../../data/prices';
---
<Page title="Fees" description="Every treatment with its lowest and highest price.">
  <section class="sec wrap">
    <PageHead label="FEES" title="Our fees, in full." intro="Every treatment with its lowest and highest price. Your exact price comes as a written treatment plan after your consultation." />
    <div class="stack stack--lg" data-reveal style="margin-top:40px">
      {FEE_GROUPS.map((g) => (
        <div class="feewrap">
          <table class="feetable" role="table">
            <caption>{g.title}</caption>
            <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Treatment</th><th scope="col" class="num" role="columnheader">From</th><th scope="col" class="num" role="columnheader">To</th></tr></thead>
            <tbody role="rowgroup">
              {g.rows.map((r) => (
                <tr data-slug={r.slug} role="row">
                  <th scope="row" role="rowheader">{r.name}</th>
                  <td class="num" data-min role="cell">{eur(r.p[0])}</td>
                  <td class="num" data-max role="cell">{eur(r.p[1])}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </div>
  </section>
  <section class="sec wrap">
    <div class="stack" data-reveal>
      <h2 class="sub-h">PRSI and medical cards</h2>
      <p class="intro">If you qualify for PRSI dental benefit, your check-up is free or reduced. We'll check your eligibility when you book. Receipts are provided for health insurance and Med 2 tax relief claims.</p>
      <p class="mono" style="font-size:13px;color:var(--ikincil)">Prices last updated {PRICES_UPDATED}.</p>
    </div>
  </section>
  <script>
    import '../../scripts/fees';
  </script>
</Page>
