---
interface Props { solid?: boolean }
const { solid = false } = Astro.props;
const links = [
  ['Treatments', '/treatments/'],
  ['Team', '/team/'],
  ['Fees', '/fees/'],
  ['Contact', '/clinic/'],
];
---
<header class={`hdr${solid ? ' hdr--solid' : ''}`} data-hdr>
  <div class="hdr__in wrap">
    <a class="logo" href="/">fennel<span>/</span>dental</a>
    <nav class="nav" aria-label="Main">
      {links.map(([t, h]) => <a href={h}>{t}</a>)}
    </nav>
    <div class="hdr__r">
      <a class="mylink" href="/my-appointments/">My appointments</a>
      <a class="tel" href="tel:+35312345018">01 234 5018</a>
      <a class="btn btn--kobalt btn--sm" href="/book/">Book a visit →</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-panel" data-menu-btn>Menu</button>
    </div>
  </div>
  <div class="menu" id="menu-panel" data-menu hidden>
    <nav class="menu__list" aria-label="Menu">
      {links.map(([t, h]) => <a class="menu__l" href={h}>{t}</a>)}
      <a class="menu__l" href="/my-appointments/">My appointments</a>
    </nav>
    <div class="menu__foot">
      <a class="btn btn--kobalt menu__book" href="/book/">Book a visit →</a>
      <a class="tel" href="tel:+35312345018">01 234 5018</a>
    </div>
  </div>
</header>
<div class="menu-bd" data-menu-backdrop hidden></div>
