---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';

interface Props { title: string; description: string; demo?: boolean; footer?: 'full' | 'minimal' }
const { title, description, demo = false, footer = 'full' } = Astro.props;
---
<Base title={`${title} — Fennel Dental`} description={description}>
  <Header solid />
  <main class="page" id="main">
    <slot />
  </main>
  <Footer minimal={footer === 'minimal'} />
  <MobileBar />
  <script>
    import '../scripts/main';
  </script>
</Base>
