---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props { title?: string; description?: string }
const { title = 'Fennel Dental — Home', description = 'See your treatment, its time and its price range before you book.' } = Astro.props;
---
<!doctype html>
<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3F4F2" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" as="image" type="image/avif" href="/img/hero/hero-arka-1536.avif" imagesrcset="/img/hero/hero-arka-768.avif 768w, /img/hero/hero-arka-1536.avif 1536w" imagesizes="100vw" fetchpriority="high" />
    <link rel="preload" as="image" type="image/avif" href="/img/hero/hero-on-1152.avif" imagesrcset="/img/hero/hero-on-768.avif 768w, /img/hero/hero-on-1152.avif 1152w, /img/hero/hero-on-1536.avif 1536w" imagesizes="(max-width: 760px) 100vw, 1140px" fetchpriority="high" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230F1A24'/%3E%3Ctext x='16' y='23' font-family='sans-serif' font-size='20' font-weight='700' text-anchor='middle' fill='%23fff'%3Ef%3C/text%3E%3C/svg%3E" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#treatments">Skip to content</a>
    <slot />
  </body>
</html>
